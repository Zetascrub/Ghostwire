docs/reference/

# Generated editor/build metadata.
compile_commands.json

# Retired local boot-art experiment.
zetascrub_cardputer_boot.gif

# Common local/editor noise.
.DS_Store
*.swp
*.swo
__pycache__/

# Local removable-media credentials. Keep only documentation and deliberately
# blank examples in source control.
sd-card-files/ghostwire/secrets/*
!sd-card-files/ghostwire/secrets/README.md
!sd-card-files/ghostwire/secrets/*.example.json

# Runtime output copied back from a real device can contain network names,
# identifiers, locations, packet data, RFID identities, and chat content.
sd-card-files/ghostwire/logs/
sd-card-files/ghostwire/tags/

# Common developer-local configuration.
.env
.env.*
*.local

# ESP-IDF output for the independent Unit PoE-P4 companion application.
/poe-p4/build/
/poe-p4/sdkconfig
/poe-p4/sdkconfig.old
/poe-p4/managed_components/
